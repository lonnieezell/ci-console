{
    "name": "lonnieezell/codeigniter-console",
    "description": "A standalone, framework agnostic, CLI suite for running commands and build phars.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Lonnie Ezell",
            "email": "lonnieje@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "codeigniter4/devkit": "^1.0",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "CodeIgniter\\Console\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CodeIgniter\\Console\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "bin": ["bin/ci"]
}
